__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
venv/
env/
ENV/
.venv/

# Настройки редакторов
.vscode/
.idea/
*.swp

# Системные файлы
.DS_Store
Thumbs.db

# Логи
*.log

# Базы данных
*.db
*.sqlite
*.sqlite3

# Секретные данные
credentials.txt
.env
*.key

# Временные файлы
*.tmp
*.bak

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Файлы Excel
~$*.xlsx
~$*.xls

# Файлы БД SQLite (дополнительные логи транзакций)
*.db-journal
*.db-wal
*.db-shm
